{
  "name": "@cyber-moshen/dsh-plugin-market",
  "version": "0.1.2",
  "description": "Open-source plugin market for the DSH web GUI: card grid with GitHub stars, last-commit freshness, and one-click install/uninstall. The catalog is this repo's own data/plugins.json — anyone can add a plugin via pull request. · 开源 DSH 插件市场：卡片式排布、星数、最近提交、一键安装；目录就是本仓库的 data/plugins.json，任何人都能通过 PR 上架插件。",
  "type": "module",
  "main": "lib/host.js",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/validate.mjs data/plugins.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "market",
    "marketplace"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ja.md"
  ]
}
